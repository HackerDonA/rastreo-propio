# =============================================================================
#  rastreo-propio — plantilla de variables de entorno
# =============================================================================
#  COPIA este archivo a .env y rellena los valores. El .env NUNCA se versiona
#  (esta en .gitignore) porque contiene la contrasena de la base y el token de
#  Traccar.
#
#  En PowerShell:
#      Copy-Item .env.example .env
#
#  Para generar una contrasena fuerte sin salir de PowerShell:
#      -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | % {[char]$_})
# =============================================================================


# -----------------------------------------------------------------------------
#  PostgreSQL
# -----------------------------------------------------------------------------
#  Los usan tanto el contenedor de PostgreSQL como el de Traccar. Si cambias la
#  contrasena DESPUES de haber levantado el proyecto la primera vez, el
#  contenedor no la va a tomar: PostgreSQL solo aplica POSTGRES_PASSWORD al
#  inicializar el volumen vacio. Para cambiarla de verdad hay que hacerlo con
#  ALTER USER dentro de la base, o borrar el volumen (y perder el historial).
POSTGRES_DB=traccar
POSTGRES_USER=traccar
POSTGRES_PASSWORD=cambia-esto-por-una-contrasena-larga-y-aleatoria

# Puerto en el que PostgreSQL queda escuchando en 127.0.0.1 de tu Windows.
# Cambialo solo si ya tienes un PostgreSQL instalado nativo ocupando el 5432.
POSTGRES_PORT=5432


# -----------------------------------------------------------------------------
#  Traccar
# -----------------------------------------------------------------------------
#  Interfaz web y API de Traccar. Aqui creas el usuario administrador la
#  primera vez y generas el token. Publicado solo en 127.0.0.1.
TRACCAR_WEB_PORT=8082

#  URL con la que NUESTRA API habla con Traccar. Como la API corre nativa en
#  Windows y Traccar esta dentro de Docker publicado en 127.0.0.1, es localhost.
TRACCAR_URL=http://127.0.0.1:8082

#  Token de API de Traccar.
#  ------------------------------------------------------------------------
#  COMO OBTENERLO (se hace una sola vez, despues de levantar los contenedores):
#    1. Abre http://localhost:8082
#    2. Crea la cuenta de administrador (correo + contrasena que tu elijas)
#    3. Entra, y en el menu de usuario ve a "Cuenta" / "Account"
#    4. Boton "Token" -> genera uno -> copialo y pegalo aqui
#
#  El BFF lo usa para dos cosas distintas:
#    · llamadas REST, con encabezado Authorization: Bearer <token>
#    · abrir una sesion (GET /api/session?token=...) y quedarse con la cookie
#      JSESSIONID, porque el WebSocket /api/socket de Traccar SOLO acepta
#      cookie de sesion; el Bearer no funciona ahi.
#
#  Este token NUNCA llega al navegador. Ver docs/adr/0002-bff-propio.md.
TRACCAR_API_TOKEN=pega-aqui-el-token-generado-en-la-interfaz-de-traccar


# -----------------------------------------------------------------------------
#  Puertos de protocolo GPS
# -----------------------------------------------------------------------------
#  Estos SI se publican en toda la red local (0.0.0.0), porque tienen que ser
#  alcanzables desde tu celular con Traccar Client y, mas adelante, desde los
#  rastreadores reales.
#
#  Cambialos solo si Windows te dice que el puerto ya esta en uso. Antes de
#  pelearte con eso, revisa el rango dinamico reservado por Hyper-V:
#      netsh int ipv4 show excludedportrange protocol=tcp
#  (explicado en docs/01-instalacion-local.md)

# osmand — app Traccar Client, simulador y pruebas con curl. Imprescindible.
PORT_OSMAND=5055

# gt06 — Concox/Jimi GT06N, JM-VL01 y clones. Los mas comunes en Mexico.
PORT_GT06=5023

# h02 — SinoTrack ST-901/903/906 y clones H02.
PORT_H02=5013

# gps103 — Coban TK103, GPS103. Tambien es el puerto que recomienda Traccar
#          para identificar un equipo desconocido.
PORT_GPS103=5001

# teltonika — FMB920, FMB003, FMC130. Gama industrial.
PORT_TELTONIKA=5027


# -----------------------------------------------------------------------------
#  Nuestra API (BFF)
# -----------------------------------------------------------------------------
# 4000 y no el 3000 habitual: en Windows, Hyper-V se reserva rangos dinamicos
# de puertos que CAMBIAN al reiniciar, y el 3000 cae dentro con frecuencia.
# Cuando pasa, el servidor falla con "EACCES: permission denied" aunque no haya
# nadie usando el puerto. Para ver los rangos reservados:
#     netsh int ipv4 show excludedportrange protocol=tcp
API_PORT=4000
API_HOST=127.0.0.1

# Nivel de log de Pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Origen permitido para CORS. En desarrollo es el servidor de Vite.
CORS_ORIGIN=http://localhost:5173

# Cada cuanto (ms) el relay agrupa las posiciones del WebSocket antes de
# reenviarlas al navegador. Con 10 unidades a 1 Hz, 750 ms convierte ~10
# mensajes por segundo en ~1.3. Subelo si algun dia tienes 50+ unidades.
WS_FLUSH_INTERVAL_MS=750

# Cada cuantos minutos corre el job que evalua los mantenimientos.
# 60 = cada hora. Bajalo a 1 para probar el job sin esperar.
MAINTENANCE_JOB_INTERVAL_MINUTES=60


# -----------------------------------------------------------------------------
#  Frontend
# -----------------------------------------------------------------------------
#  Vite solo expone al navegador las variables que empiezan con VITE_.
#  NO pongas aqui nada secreto: todo esto termina en el bundle publico.
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws

# Estilos de OpenFreeMap. Gratis, sin registro, sin API key y sin limite de
# peticiones; solo pide atribucion. Verificados: responden 200.
# Otros disponibles: bright, positron, fiord
VITE_MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/liberty
VITE_MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark

# Centro inicial del mapa (Ciudad de Mexico) y zoom.
VITE_MAP_CENTER_LNG=-99.1332
VITE_MAP_CENTER_LAT=19.4326
VITE_MAP_ZOOM=11
